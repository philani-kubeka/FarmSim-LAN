[node name="Description" type="Label" parent="Box"]
size_flags_horizontal = 3
theme_type_variation = &"Note"
autowrap_mode = 3
text = "What this player is responsible for."

[node name="Move" type="Label" parent="Box"]
autowrap_mode = 3
theme_type_variation = &"Dim"
text = "Move:"

[node name="Use" type="Label" parent="Box"]
autowrap_mode = 3
theme_type_variation = &"Dim"
text = "Use tool:"

[node name="Tools" type="Label" parent="Box"]
size_flags_horizontal = 3
theme_type_variation = &"Note"
autowrap_mode = 3
text = "Carries:"
