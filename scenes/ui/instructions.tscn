[node name="CropBody" type="Label" parent="Page/PageScroll/Row/PageContent"]
size_flags_horizontal = 3
text = "Soil must be tilled before it can be sown. A sown tile grows only while it has enough moisture; moisture falls continuously and falls faster in hot, dry conditions. A tile left dry loses condition, and lost condition is not fully recovered by watering it later. Pests reduce condition for as long as they are left untreated and can spread to neighbouring tiles. Final yield depends on how far the crop grew and what condition it was in."
autowrap_mode = 3

