[node name="Columns" type="HBoxContainer" parent="Page/PageScroll/Row/PageContent"]
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="StatGrid" type="GridContainer" parent="Page/PageScroll/Row/PageContent/Columns"]
