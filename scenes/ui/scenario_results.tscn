[ext_resource type="PackedScene" path="res://scenes/ui/components/stat_card.tscn" id="3_stat"]

[node name="ScenarioResults" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
